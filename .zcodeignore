# pxb7-price-monitor —— 版本控制忽略清单
#
# 红线：登录态文件（data/state/storage_*.json，含站点 Cookie）**绝不入库、不外传**；
# 采集产物（raw / runs / 日志 / DuckDB）与虚拟环境同理，只保留代码、配置、文档、测试。

# 虚拟环境（本机 Python 3.14.7）
.venv/
venv/

# 运行期数据（原始 DOM dump / 登录态 / 风控状态 / 轮次 summary / 日志 / 插件配置）
data/raw/
data/state/
data/runs/
data/logs/
data/analysis/
data/calibration-*.duckdb

# DuckDB（含 WAL）
*.duckdb
*.duckdb.wal
*.duckdb.tmp

# 本机路径自定义（含本地绝对路径，按机器而异）
config/paths_override.json

# 本地安全钩子状态与对话/工作流草稿
.mimosa/
.zcode/

# 备份快照（改前留档）：本地保险，不随仓库分发
*.bak.md
*.bak.yaml
*.bak.py

# Windows 误建文件与编辑器临时文件
nul
*.tmp
*~

# Python 产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 测试缓存
.pytest_cache/
.coverage
htmlcov/


# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
coverage/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
