{
  "manifest_version": 3,
  "name": "pxb7 采集助手（前端 B）",
  "version": "0.5.13",
  "description": "按商品ID跨批次去重；列表变化更新、缺项自动重试一次；看板按账号对比历史变化；支持详情队列、查缺补录、验证恢复与网关启停。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "clipboardWrite", "alarms", "nativeMessaging"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "pxb7 采集看板",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pxb7.com/buy/*",
        "https://www.pxb7.com/product/*"
      ],
      "js": ["sweep.js", "titles.js", "verification.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.pxb7.com/buy/*", "https://www.pxb7.com/product/*"],
      "js": ["title-source.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
