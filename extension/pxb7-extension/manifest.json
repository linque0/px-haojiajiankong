{
  "manifest_version": 3,
  "name": "pxb7 采集助手（前端 B）",
  "version": "0.5.15",
  "description": "逻辑任务按用户规模分块；价格先入库、完整文字优先与必要详情；支持价格复采、详情补齐、定时领取、合并导出及验证恢复。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "clipboardWrite", "alarms", "nativeMessaging", "debugger"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "pxb7 采集看板",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pxb7.com/buy/*",
        "https://www.pxb7.com/product/*"
      ],
      "js": ["sweep.js", "titles.js", "verification.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.pxb7.com/buy/*", "https://www.pxb7.com/product/*"],
      "js": ["title-source.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
